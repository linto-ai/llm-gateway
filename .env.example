# Docker UID/GID (for development)
# Match your host user to avoid permission issues: id -u && id -g
UID=1000
GID=1000

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=llm_gateway
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# =============================================================================
# Redis / Celery
# =============================================================================
REDIS_PASSWORD=your-secure-redis-password
SERVICES_BROKER=redis://task-broker-redis:6379
SERVICES_BROKER_PASSWORD=${REDIS_PASSWORD}
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@task-broker-redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@task-broker-redis:6379/0

# Worker replicas (use docker compose --scale celery-worker=N or this variable)
CELERY_WORKERS=1

# =============================================================================
# Security
# =============================================================================
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example (DO NOT use in production - generate your own key):
ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# =============================================================================
# API Server
# =============================================================================
HTTP_PORT=8000
DEBUG=false

# CORS origins (comma-separated, REQUIRED)
# Use "*" only for local development. In production, list allowed origins explicitly.
# Example: CORS_ORIGINS=https://my-domain.com,https://admin.my-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# =============================================================================
# Logging
# =============================================================================
# Level: DEBUG / INFO / WARNING / ERROR (DEBUG=true above forces DEBUG).
LOG_LEVEL=INFO
# Output format on stdout: "text" (human readable) or "json" (structured,
# for log aggregators that scrape container stdout: Loki, ELK, Cloud Logging).
LOG_FORMAT=text
# Service label added to JSON logs / Stackdriver entries.
LOG_NAME=llm-gateway
#
# --- Optional sinks (each is disabled until its trigger var is set) ---
#
# Rotating file:
# LOG_FILE=/var/log/llm-gateway/app.log
# LOG_FILE_LEVEL=INFO
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5
#
# HTTP POST to a centralized collector (records shipped as JSON, non-blocking):
# LOG_HTTP_URL=https://logs.example.com/ingest
# LOG_HTTP_METHOD=POST
# LOG_HTTP_HEADERS={"Authorization": "Bearer <token>"}
# LOG_HTTP_LEVEL=INFO
# LOG_HTTP_TIMEOUT=5.0
#
# Google Cloud Logging / Stackdriver (requires google-cloud-logging, see requirements.txt):
# LOG_STACKDRIVER_ENABLED=true
# LOG_STACKDRIVER_PROJECT=my-gcp-project
# LOG_STACKDRIVER_LEVEL=INFO
#
# Full control: a JSON file passed verbatim to logging.config.dictConfig.
# When set, all LOG_* vars above are ignored (Winston WINSTON_CONFIG_PATH equivalent).
# LOGGING_CONFIG_FILE=/app/config/logging.json

# =============================================================================
# LLM API Retry Configuration
# =============================================================================
API_MAX_RETRIES=6
API_RETRY_MIN_DELAY=1
API_RETRY_MAX_DELAY=60

# =============================================================================
# Storage
# =============================================================================
# HuggingFace tokenizers cache (writable; mount-friendly, read first)
TOKENIZER_STORAGE_PATH=./tokenizers
# Read-only tokenizers baked into the image (see scripts/bake_tokenizers.py)
# TOKENIZER_BUNDLED_PATH=/opt/linto/tokenizers
# Closed site with no HF egress: skip any job-time download, estimate with tiktoken
# TOKENIZER_OFFLINE=false
# Hard cap (seconds) on one tokenizer download before falling back
# TOKENIZER_DOWNLOAD_TIMEOUT=30

# Celery backstop for stuck tasks (seconds). visibility timeout MUST stay > hard limit.
# TASK_SOFT_TIME_LIMIT=540
# TASK_TIME_LIMIT=600
# BROKER_VISIBILITY_TIMEOUT=900
